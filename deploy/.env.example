# Ambiente da instalação self-hosted. NUNCA versione o deploy/.env preenchido (§5.1) — só este
# .example entra no git. No Portainer você não usa este arquivo: cola estes mesmos pares no painel
# *Environment variables* da stack (ver deploy/README.md).
#
#   cp deploy/.env.example deploy/.env && make gen-keys   # cole as duas chaves geradas abaixo

# --- Segredos desta instalação (obrigatórios) -------------------------------------------------
# Gere com `make gen-keys`. São seus, desta máquina: não existem no repositório e não devem ser
# reaproveitados de outra instância. Trocar a ENCRYPTION_KEY torna ilegíveis as credenciais já
# cifradas no banco (será preciso reconectar o Pluggy).
ENCRYPTION_KEY=
SECRET_KEY=
# Senha do PostgreSQL da stack. Use apenas letras e números: o valor entra montado numa URL de
# conexão, e caracteres como @ : / # exigiriam escape.
POSTGRES_PASSWORD=

# --- Stack de produção (deploy/docker-compose.yml) --------------------------------------------
# Versão da imagem no GHCR. Fixe uma tag (ex.: 0.1.0) para que upgrades sejam decisão sua.
MANGO_TAG=latest

# Onde a porta do app é publicada. O padrão só escuta em loopback: o acesso de fora passa por um
# reverse proxy com TLS. Para expor direto na rede (sem TLS), mude para 0.0.0.0 conscientemente.
BIND_ADDR=127.0.0.1
APP_PORT=8000

# Cookie de sessão `Secure` só trafega em HTTPS — este é o padrão porque o destino normal é atrás
# de um reverse proxy com TLS. Mude para `false` **apenas** enquanto testar direto em http://:
# com `true` sobre http o navegador descarta o cookie e o login não completa.
SESSION_COOKIE_SECURE=true

# IPs de quem o uvicorn aceita cabeçalhos X-Forwarded-*. Com o reverse proxy noutro container, a
# requisição chega de um IP da rede Docker e o padrão (127.0.0.1) descarta os cabeçalhos — a app
# se enxerga em http:// mesmo servida por HTTPS. Nesse caso, use a sub-rede do proxy ou `*`.
# `*` só é seguro se a porta NÃO estiver publicada em 0.0.0.0 (senão o cabeçalho é forjável).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Somente para a stack que builda do código-fonte (docker-compose.selfhosted.yml) ----------
# Esse arquivo injeta este .env direto no container, então precisa dos valores abaixo.
# A stack de produção define os dois sozinha e ignora estas linhas.
APP_MODE=self_hosted
DATABASE_URL=postgresql+psycopg://mango:mango@db:5432/mango
