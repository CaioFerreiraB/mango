# Ambiente do container self-hosted. Copie para deploy/.env e preencha os segredos:
#   cp deploy/.env.example deploy/.env && make gen-keys   # cole as duas chaves geradas
# NUNCA versione o deploy/.env (§5.1) — só este .example entra no git.

APP_MODE=self_hosted

# Postgres do compose (rede interna; host = nome do serviço `db`).
DATABASE_URL=postgresql+psycopg://mango:mango@db:5432/mango

# Segredos de runtime (§5.1/§5.5) — gere com `make gen-keys`:
ENCRYPTION_KEY=
SECRET_KEY=

# Cookie de sessão `Secure` exige HTTPS. Em produção (reverse proxy TLS) use true.
# Para testar localmente em http://localhost, use false.
SESSION_COOKIE_SECURE=false
