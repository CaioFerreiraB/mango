# Credenciais do Pluggy para a fase de descoberta (sandbox).
# Copie para .env (NÃO versionado) e preencha:
#   cp scripts/discovery/.env.example scripts/discovery/.env
#
# Crie um app no nível gratuito do Pluggy e pegue clientId/clientSecret em:
#   https://dashboard.pluggy.ai  → Applications

PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Opcional: se você já tem uma conexão (item) pelo Meu Pluggy, informe o itemId
# para pular a criação do item de sandbox e explorar dados reais.
# PLUGGY_ITEM_ID=
