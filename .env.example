# Configuração local — copie para .env (não versionado) e ajuste.
#   cp .env.example .env

# Modo de execução: local (desktop monousuário) | self_hosted (multiusuário)
APP_MODE=local

# Banco. SQLite por padrão (dev). Postgres no self-hosted/CI, ex.:
#   DATABASE_URL=postgresql+psycopg://mango:mango@localhost:5432/mango
DATABASE_URL=sqlite:///./mango.db

# Segredos de runtime — NUNCA versionar valores reais (§5.1/§5.5).
# Assinatura de sessão (auth da Fase 1):
SECRET_KEY=dev-insecure-secret-change-me
# Cifragem em repouso (Fernet). Gerar uma nova:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=3CPNFKQBk0AU10njLXpJ2sj9ZB_-MeviTY3tixSptxE=
