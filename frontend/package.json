    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.35.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "^4.2.0",
