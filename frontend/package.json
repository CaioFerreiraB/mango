{
  "name": "frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "npm run generate:api && vite",
    "build": "npm run generate:api && tsc -b && vite build",
    "generate:api": "openapi-typescript ./openapi.json -o src/lib/api/schema.d.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run generate:api && tsc -b --force",
    "preview": "vite preview"
  },
  "dependencies": {
