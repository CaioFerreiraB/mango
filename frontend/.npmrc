# O preset shadcn fixa versões de ponta (TypeScript 6, Vite 8, ESLint 10) à frente das faixas de
# peerDependencies de várias libs (ex.: openapi-typescript@7 declara typescript@^5.x). O conflito é
# só de faixa declarada — a saída gerada compila no TS 6. legacy-peer-deps mantém npm install/ci
# consistentes sem --force a cada vez.
legacy-peer-deps=true
